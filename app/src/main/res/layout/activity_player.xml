<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/black">

    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@string/background_image" />
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#66000000" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="14dp" android:paddingBottom="24dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageButton android:id="@+id/expand" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_keyboard_arrow_down" android:contentDescription="@string/cancel" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageButton android:id="@+id/theme" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_tshirt" android:contentDescription="@string/settings" />
            <ImageButton android:id="@+id/menu" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_more" android:contentDescription="@string/settings" />
        </LinearLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <com.umar.musicplayer.VinylDiscView android:id="@+id/disc" android:layout_width="match_parent" android:layout_height="match_parent" />
            <com.umar.musicplayer.TonearmView android:id="@+id/arm" android:layout_width="match_parent" android:layout_height="match_parent" />
            <ImageButton android:id="@+id/rew" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="2dp" android:background="@drawable/bg_circle_dark" android:rotation="180" android:src="@drawable/ic_loop_arrow" android:contentDescription="Rewind 10" />
            <TextView android:id="@+id/rewLabel" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="2dp" android:gravity="center" android:text="10" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />
            <ImageButton android:id="@+id/fwd" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="2dp" android:background="@drawable/bg_circle_dark" android:src="@drawable/ic_loop_arrow" android:contentDescription="Forward 10" />
            <TextView android:id="@+id/fwdLabel" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="2dp" android:gravity="center" android:text="10" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />
        </FrameLayout>

        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="2dp">
            <TextView android:id="@+id/artist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/gray_text" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
            <ImageButton android:id="@+id/star" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="8dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_star" android:contentDescription="@string/favourites" />
        </LinearLayout>

        <SeekBar android:id="@+id/seek" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:progressTint="@color/purple" android:thumbTint="@color/white" android:progressBackgroundTint="#33FFFFFF" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/cur" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/gray_text" android:textSize="12sp" android:text="0:00" />
            <TextView android:id="@+id/tot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/gray_text" android:textSize="12sp" android:text="0:00" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="8dp" android:layout_marginBottom="48dp">
            <ImageButton android:id="@+id/repeat" android:layout_width="44dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_repeat" android:contentDescription="@string/shuffle" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageButton android:id="@+id/prev" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_skip_prev" android:contentDescription="Prev" />
            <ImageButton android:id="@+id/play" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginHorizontal="14dp" android:background="@drawable/bg_circle_purple" android:src="@drawable/ic_play" android:contentDescription="Play" />
            <ImageButton android:id="@+id/next" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_skip_next" android:contentDescription="Next" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageButton android:id="@+id/queue" android:layout_width="44dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_queue_music" android:contentDescription="@string/queue" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>